# Configuración de PasoAPaso 2.0
# Copia este archivo como «.env» y cambia los valores.
# El archivo .env no se debe subir a internet ni compartir.

# --- Servidor ---------------------------------------------------------------
PASOAPASO_HOST=127.0.0.1
PASOAPASO_PORT=8765
# Genera una cadena larga y aleatoria. Si la dejas vacía, el servidor crea una.
PASOAPASO_SECRETO=
PASOAPASO_PRODUCCION=0
# Pon 1 solo si el servidor está detrás de un proxy con HTTPS (Render, Railway...).
PASOAPASO_PROXY=0
# Directorio de la base de datos. Por defecto: ./datos
PASOAPASO_DATOS=

# --- Cuenta de administrador ------------------------------------------------
PASOAPASO_ADMIN_USUARIO=admin
PASOAPASO_ADMIN_NOMBRE=Administrador de PasoAPaso
# Cambia esta clave antes de mostrar el proyecto. Mínimo 8 caracteres.
PASOAPASO_ADMIN_CLAVE=PasoAPaso2026
# Para volver a aplicar la clave de arriba sobre una base ya creada:
PASOAPASO_ADMIN_RESET=0

# --- Inteligencia artificial (opcional) ------------------------------------
# Consigue una clave gratis en https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODELO=gemini-2.5-flash
PASOAPASO_IA=1

# --- App de escritorio ------------------------------------------------------
# Déjalo vacío para usar el servidor local que arranca con la app.
# Para usar un servidor en internet, escribe su dirección:
# PASOAPASO_API_URL=https://pasoapaso.onrender.com
PASOAPASO_API_URL=
PASOAPASO_TIMEOUT=8
